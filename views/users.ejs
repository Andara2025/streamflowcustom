function formatDate(dateString) {
      if (!dateString) return 'Unknown';
      const date = new Date(dateString);
      return date.toLocaleDateString('id-ID', {
        year: 'numeric',
        month: 'short',
        day: 'numeric'
      }) + ' ' + date.toLocaleTimeString('id-ID', {
        hour: '2-digit',
        minute: '2-digit'
      });
    }

    function formatFileSize(bytes) {
      if (!bytes || bytes === 0) return '0 B';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    function formatDuration(seconds) {
      if (!seconds || seconds === 0) return '00:00:00';
      
      const totalSeconds = Math.floor(parseFloat(seconds));
      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const secs = totalSeconds % 60;
      
      return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    }

    let blastTargetUsers = [];

    function formatWaPhoneNumber(raw) {
      if (!raw) return '';
      let clean = raw.replace(/[^0-9]/g, '');
      if (clean.startsWith('0')) {
        clean = '62' + clean.slice(1);
      } else if (!clean.startsWith('62') && clean.length > 0) {
        clean = '62' + clean;
      }
      return clean;
    }

    function setBlastTemplate(type) {
      const el = document.getElementById('blastCustomMessage');
      if (!el) return;
      if (type === 'expired') {
        el.value = 'Halo {name},\n\nMasa aktif akun StreamFlow paket {package} Anda telah Expired. Silakan segera melakukan perpanjangan agar live streaming dapat terus berjalan tanpa gangguan.\n\nTerima kasih.';
      } else if (type === 'soon') {
        el.value = 'Halo {name},\n\nMasa aktif akun StreamFlow paket {package} Anda akan berakhir dalam {days} hari lagi. Segera perpanjang paket Anda agar jadwal live stream tetap berjalan lancar.\n\nTerima kasih.';
      } else if (type === 'announcement') {
        el.value = 'Halo {name},\n\nAda informasi penting untuk seluruh member StreamFlow (Paket {package}):\n\n[Tulis pesan pengumuman Anda di sini]\n\nTerima kasih.';
      }
      renderBlastList(el.value);
    }

    function insertVariable(v) {
      const el = document.getElementById('blastCustomMessage');
      if (!el) return;
      const start = el.selectionStart;
      const end = el.selectionEnd;
      const text = el.value;
      if (start !== undefined && end !== undefined) {
        el.value = text.substring(0, start) + v + text.substring(end);
        el.focus();
        el.selectionStart = el.selectionEnd = start + v.length;
      } else {
        el.value += ' ' + v;
      }
      renderBlastList(el.value);
    }

    function markBlastSent(btn) {
      if (!btn) return;
      btn.classList.remove('bg-emerald-600', 'hover:bg-emerald-500', 'shadow-md', 'shadow-emerald-600/25');
      btn.classList.add('bg-gray-700', 'text-emerald-300', 'border', 'border-emerald-500/40');
      btn.innerHTML = '<i class="ti ti-check text-sm text-emerald-400"></i> Terkirim';
    }

    function renderBlastList(customTemplate) {
      const template = customTemplate !== undefined ? customTemplate : (document.getElementById('blastCustomMessage')?.value || 'Halo {name}, akun StreamFlow Anda telah Expired. Silakan perpanjang paket untuk melanjutkan streaming.\n\nTerima kasih.');
      
      if (!blastTargetUsers || blastTargetUsers.length === 0) {
        const blastListEl = document.getElementById('blastList');
        if (blastListEl) {
          blastListEl.innerHTML = '<div class="text-center py-8 text-gray-400 text-sm"><i class="ti ti-users-minus text-3xl mb-2 text-gray-500 block"></i>Tidak ada user pada hasil filter saat ini.</div>';
        }
        return;
      }

      let html = '<div class="space-y-2">';
      let withPhoneCount = 0;

      blastTargetUsers.forEach((user, i) => {
        let msg = template
          .replace(/\{name\}/g, user.name)
          .replace(/\{username\}/g, user.username)
          .replace(/\{package\}/g, user.package)
          .replace(/\{days\}/g, user.daysLeft > 0 ? user.daysLeft : 0);
        
        const hasPhone = !!user.waPhone;
        if (hasPhone) withPhoneCount++;
        const waUrl = hasPhone ? `https://wa.me/${user.waPhone}?text=${encodeURIComponent(msg)}` : '#';
        
        html += `
          <div class="flex items-center justify-between p-3 bg-dark-800 hover:bg-dark-700/80 border border-gray-700/60 rounded-xl transition-all gap-3 shadow-sm">
            <div class="flex items-center gap-3 min-w-0 flex-1">
              <span class="text-gray-400 text-xs font-semibold w-6 text-right flex-shrink-0">${i + 1}.</span>
              <div class="truncate">
                <div class="flex items-center gap-2 flex-wrap">
                  <p class="text-white text-sm font-semibold truncate">${escapeHtml(user.name)}</p>
                  <span class="inline-flex px-2 py-0.5 text-[10px] font-bold rounded-full uppercase bg-yellow-500/15 text-yellow-300 border border-yellow-500/30">
                    ${escapeHtml(user.package)}
                  </span>
                  <span class="inline-flex px-2 py-0.5 text-[10px] font-semibold rounded-full ${user.statusBadge}">
                    ${user.statusText}
                  </span>
                </div>
                <div class="flex items-center gap-2 mt-1 text-xs">
                  <span class="font-mono ${hasPhone ? 'text-emerald-400' : 'text-gray-500 italic'}">
                    ${hasPhone ? ('+' + user.waPhone) : 'Belum ada nomor WA'}
                  </span>
                </div>
              </div>
            </div>
            <div>
              ${hasPhone ? `
                <a href="${waUrl}" 
                   target="_blank"
                   onclick="markBlastSent(this)"
                   class="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-lg transition-all flex items-center gap-1.5 flex-shrink-0 shadow-md shadow-emerald-600/25 hover:scale-105 active:scale-95">
                  <i class="ti ti-brand-whatsapp text-sm"></i> Kirim WA
                </a>
              ` : `
                <span class="px-2.5 py-1.5 bg-gray-700/40 text-gray-400 text-xs rounded-lg flex items-center gap-1 flex-shrink-0 border border-gray-700 cursor-not-allowed">
                  <i class="ti ti-phone-off text-xs"></i> Tanpa WA
                </span>
              `}
            </div>
          </div>`;
      });
      html += '</div>';
      
      const blastListEl = document.getElementById('blastList');
      if (blastListEl) blastListEl.innerHTML = html;
      const countEl = document.getElementById('blastCount');
      if (countEl) countEl.textContent = blastTargetUsers.length;
      const summaryEl = document.getElementById('blastSummaryText');
      if (summaryEl) {
        summaryEl.textContent = `${withPhoneCount} dari ${blastTargetUsers.length} user memiliki nomor WhatsApp siap kirim.`;
      }
    }

    function blastWhatsApp() {
      const rows = document.querySelectorAll('.user-row');
      blastTargetUsers = [];
      let withPhone = 0;
      
      // Ambil seluruh user yang SEDANG TAMPIL di tabel (lolos semua filter saat ini)
      rows.forEach(row => {
        if (row.style.display === 'none') {
          return; // Skip baris yang disembunyikan oleh filter search, status, role, atau expired
        }

        const username = row.dataset.displayName || row.dataset.username || '';
        const rawPhone = row.dataset.phone || '';
        const expState = row.dataset.expiredState || 'none';
        const daysLeft = parseInt(row.dataset.daysLeft || '999999');
        const packageName = row.dataset.package || 'custom';
        const waPhone = formatWaPhoneNumber(rawPhone);

        let statusBadge = '';
        let statusText = '';
        if (daysLeft <= 0 && expState === 'expired') {
          statusBadge = 'bg-red-900/50 text-red-300 border border-red-500/30';
          statusText = 'Expired';
        } else if (daysLeft <= 7 && expState === 'soon') {
          statusBadge = 'bg-yellow-900/50 text-yellow-300 border border-yellow-500/30';
          statusText = `${daysLeft} hr lagi`;
        } else if (expState === 'none') {
          statusBadge = 'bg-gray-700 text-gray-300 border border-gray-600/50';
          statusText = 'Tanpa Expired';
        } else {
          statusBadge = 'bg-green-900/50 text-green-300 border border-green-500/30';
          statusText = 'Aktif';
        }

        if (waPhone) withPhone++;

        blastTargetUsers.push({
          name: username,
          username: username,
          phone: rawPhone,
          waPhone: waPhone,
          daysLeft,
          package: packageName,
          statusText,
          statusBadge
        });
      });
      
      if (blastTargetUsers.length === 0) {
        showToast('Tidak ada user yang tampil pada tabel untuk dibroadcast.', 'error');
        return;
      }
      
      const customMsgEl = document.getElementById('blastCustomMessage');
      if (customMsgEl) {
        // Tentukan template bawaan berdasarkan mayoritas status user yang difilter
        const hasExpired = blastTargetUsers.some(u => u.statusText === 'Expired');
        const hasSoon = blastTargetUsers.some(u => u.statusText.includes('hr lagi'));
        
        if (hasExpired && !hasSoon) {
          customMsgEl.value = 'Halo {name},\n\nMasa aktif akun StreamFlow paket {package} Anda telah Expired. Silakan perpanjang paket untuk melanjutkan streaming tanpa gangguan.\n\nTerima kasih.';
        } else if (hasSoon) {
          customMsgEl.value = 'Halo {name},\n\nMasa aktif akun StreamFlow paket {package} Anda akan berakhir dalam {days} hari lagi. Segera perpanjang paket Anda agar live stream tetap berjalan lancar.\n\nTerima kasih.';
        } else {
          customMsgEl.value = 'Halo {name},\n\nSalam dari PEJUANG MONET. Berikut adalah informasi terbaru terkait layanan StreamFlow paket {package} Anda.\n\nTerima kasih.';
        }
        
        customMsgEl.oninput = function() {
          renderBlastList(this.value);
        };
      }

      const subtitleEl = document.getElementById('blastSubtitle');
      if (subtitleEl) {
        subtitleEl.textContent = `Memuat ${blastTargetUsers.length} user hasil filter tabel (${withPhone} memiliki nomor WhatsApp)`;
      }

      renderBlastList();
      
      const modal = document.getElementById('blastModal');
      const modalContent = document.getElementById('blastModalContent');
      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        modalContent.classList.remove('opacity-0', 'scale-95');
        modalContent.classList.add('opacity-100', 'scale-100');
      }, 10);
    }
    
    function closeBlastModal() {
      const modal = document.getElementById('blastModal');
      const modalContent = document.getElementById('blastModalContent');
      modal.classList.add('opacity-0');
      modalContent.classList.remove('opacity-100', 'scale-100');
      modalContent.classList.add('opacity-0', 'scale-95');
      setTimeout(() => { modal.classList.add('hidden'); }, 200);
    }

    let lastImportPasswords = [];

    function escapeHtml(s) {
      return String(s === undefined || s === null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;')
        .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function importUsersCsv(input) {
      if (!input.files || !input.files[0]) return;
      const formData = new FormData();
      formData.append('csv', input.files[0]);
      input.value = '';
      showToast('Mengupload & memproses CSV...', 'success');
      fetch('/admin/users/import', { method: 'POST', body: formData })
      .then(response => response.json())
      .then(data => { showImportResult(data); })
      .catch(error => {
        console.error('Import error:', error);
        showToast('Gagal import CSV', 'error');
      });
    }

    function showImportResult(data) {
      lastImportPasswords = [];
      let html = '';
      if (!data.success) {
        html = '<p class="text-red-400">' + (data.message || 'Gagal import CSV.') + '</p>';
      } else {
        html += '<div class="grid grid-cols-3 gap-3 mb-4 text-center">'
          + '<div class="bg-green-900/30 border border-green-600/30 rounded-lg p-3"><p class="text-2xl font-bold text-green-400">' + data.imported.length + '</p><p class="text-xs text-gray-400">Masuk</p></div>'
          + '<div class="bg-yellow-900/30 border border-yellow-600/30 rounded-lg p-3"><p class="text-2xl font-bold text-yellow-400">' + data.skipped.length + '</p><p class="text-xs text-gray-400">Diskip</p></div>'
          + '<div class="bg-red-900/30 border border-red-600/30 rounded-lg p-3"><p class="text-2xl font-bold text-red-400">' + data.failed.length + '</p><p class="text-xs text-gray-400">Gagal</p></div>'
          + '</div>';
        if (data.imported.length > 0) {
          html += '<p class="text-sm font-medium text-white mb-2">User masuk + password sementara:</p><div class="space-y-2 mb-4">';
          data.imported.forEach(function(u) {
            lastImportPasswords.push(u);
            html += '<div class="flex items-center justify-between p-2.5 bg-dark-700 rounded-lg text-sm">'
              + '<div><p class="text-white font-medium">' + escapeHtml(u.username) + '</p>'
              + '<p class="text-gray-400 text-xs">' + escapeHtml(u.email || '-') + '</p></div>'
              + '<code class="px-2 py-1 bg-dark-900 border border-gray-600 rounded text-yellow-300 text-xs">' + escapeHtml(u.tempPassword) + '</code>'
              + '</div>';
          });
          html += '</div>';
        }
        if (data.skipped.length > 0) {
          html += '<p class="text-sm font-medium text-white mb-2">Diskip (sudah ada):</p><div class="space-y-1 mb-4">';
          data.skipped.forEach(function(s) {
            html += '<p class="text-xs text-yellow-300/90">• ' + escapeHtml(s.username) + ' — ' + escapeHtml(s.reason) + '</p>';
          });
          html += '</div>';
        }
        if (data.failed.length > 0) {
          html += '<p class="text-sm font-medium text-white mb-2">Gagal:</p><div class="space-y-1">';
          data.failed.forEach(function(f) {
            html += '<p class="text-xs text-red-400">• ' + escapeHtml(f.username || ('baris ' + f.row)) + ' — ' + escapeHtml(f.reason) + '</p>';
          });
          html += '</div>';
        }
      }
      document.getElementById('importResult').innerHTML = html;
      const modal = document.getElementById('importModal');
      const modalContent = document.getElementById('importModalContent');
      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        modalContent.classList.remove('opacity-0', 'scale-95');
        modalContent.classList.add('opacity-100', 'scale-100');
      }, 10);
    }

    function closeImportModal() {
      const modal = document.getElementById('importModal');
      const modalContent = document.getElementById('importModalContent');
      modal.classList.add('opacity-0');
      modalContent.classList.remove('opacity-100', 'scale-100');
      modalContent.classList.add('opacity-0', 'scale-95');
      setTimeout(() => { modal.classList.add('hidden'); }, 200);
    }

    function downloadImportPasswords() {
      if (lastImportPasswords.length === 0) { showToast('Tidak ada password untuk diunduh', 'error'); return; }
      let txt = 'Username,Email,Password Sementara\n';
      lastImportPasswords.forEach(function(u) {
        txt += u.username + ',' + (u.email || '') + ',' + u.tempPassword + '\n';
      });
      const blob = new Blob([txt], { type: 'text/plain' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'password-sementara-member.txt';
      a.click();
      URL.revokeObjectURL(a.href);
    }
</script>