function sortAndFilterUsers() {
  const searchTerm = (document.getElementById('searchInput')?.value || '').toLowerCase().trim();
  const roleFilter = document.getElementById('roleFilter')?.value || '';
  const statusFilter = document.getElementById('statusFilter')?.value || '';
  const expiredFilter = document.getElementById('expiredFilter')?.value || '';
  const sortFilter = document.getElementById('sortFilter')?.value || 'default';

  const tbody = document.getElementById('usersTableBody');
  if (!tbody) return;

  const rows = Array.from(tbody.querySelectorAll('.user-row'));
  const defaultEmptyState = document.getElementById('defaultEmptyState');
  const searchEmptyState = document.getElementById('searchEmptyState');

  // Sorting
  if (sortFilter !== 'default') {
    rows.sort((a, b) => {
      if (sortFilter === 'expired-asc') {
        const tsA = parseInt(a.dataset.expiredTimestamp || '0');
        const tsB = parseInt(b.dataset.expiredTimestamp || '0');
        if (tsA === 0 && tsB === 0) return 0;
        if (tsA === 0) return 1;
        if (tsB === 0) return -1;
        return tsA - tsB;
      } else if (sortFilter === 'expired-desc') {
        const tsA = parseInt(a.dataset.expiredTimestamp || '0');
        const tsB = parseInt(b.dataset.expiredTimestamp || '0');
        return tsB - tsA;
      } else if (sortFilter === 'name-asc') {
        return (a.dataset.username || '').localeCompare(b.dataset.username || '');
      } else if (sortFilter === 'name-desc') {
        return (b.dataset.username || '').localeCompare(a.dataset.username || '');
      } else if (sortFilter === 'created-desc') {
        const cA = parseInt(a.dataset.createdTimestamp || '0');
        const cB = parseInt(b.dataset.createdTimestamp || '0');
        return cB - cA;
      }
      return 0;
    });

    rows.forEach(r => tbody.appendChild(r));
    if (searchEmptyState) tbody.appendChild(searchEmptyState);
    if (defaultEmptyState) tbody.appendChild(defaultEmptyState);
  }

  let visibleCount = 0;
  const hasFilters = searchTerm || roleFilter || statusFilter || expiredFilter;

  rows.forEach(row => {
    const username = row.dataset.username || '';
    const phone = row.dataset.phone || '';
    const role = row.dataset.role || '';
    const status = row.dataset.status || '';
    const expState = row.dataset.expiredState || 'none';
    const daysLeft = parseInt(row.dataset.daysLeft || '999999');

    const matchesSearch = !searchTerm || username.includes(searchTerm) || phone.includes(searchTerm);
    const matchesRole = !roleFilter || role === roleFilter;
    const matchesStatus = !statusFilter || status === statusFilter;
    
    let matchesExpired = true;
    if (expiredFilter === 'expired') {
      matchesExpired = expState === 'expired';
    } else if (expiredFilter === 'soon') {
      matchesExpired = expState === 'soon';
    } else if (expiredFilter === 'soon3') {
      matchesExpired = expState === 'soon' && daysLeft <= 3;
    } else if (expiredFilter === 'active') {
      matchesExpired = expState === 'active';
    } else if (expiredFilter === 'none') {
      matchesExpired = expState === 'none';
    }

    if (matchesSearch && matchesRole && matchesStatus && matchesExpired) {
      row.style.display = '';
      visibleCount++;
    } else {
      row.style.display = 'none';
    }
  });

  const btnBlastBadge = document.getElementById('btnBlastFilterCount');
  if (btnBlastBadge) {
    btnBlastBadge.textContent = visibleCount;
  }

  if (defaultEmptyState) {
    defaultEmptyState.style.display = 'none';
  }

  if (hasFilters && visibleCount === 0) {
    searchEmptyState.classList.remove('hidden');
  } else {
    searchEmptyState.classList.add('hidden');
  }

  if (!hasFilters && visibleCount === 0 && defaultEmptyState) {
    defaultEmptyState.style.display = '';
  }
}

function filterUsers() {
  sortAndFilterUsers();
}


