function updatePillsActive(currentVal) {
  const pills = ['all', 'expired', 'soon', 'active'];
  pills.forEach(p => {
    const btn = document.getElementById('pill-' + p);
    if (!btn) return;
    const isActive = (p === 'all' && !currentVal) || (p === currentVal);
    if (isActive) {
      btn.classList.add('ring-2', 'ring-offset-2', 'ring-offset-dark-800', 'ring-primary', 'font-semibold');
    } else {
      btn.classList.remove('ring-2', 'ring-offset-2', 'ring-offset-dark-800', 'ring-primary', 'font-semibold');
