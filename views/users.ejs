<script>
let currentAction = null;

function showToast(message, type = 'success') {
  const toast = document.getElementById('toast');
  const toastIcon = document.getElementById('toast-icon');
  const toastMessage = document.getElementById('toast-message');
  
  if (type === 'success') {
    toastIcon.className = 'ti ti-check text-green-400 text-xl mr-2 font-loaded';
  } else {
    toastIcon.className = 'ti ti-x text-red-400 text-xl mr-2 font-loaded';
  }
  
  toast.className = 'fixed top-16 right-4 bg-dark-800 text-white px-4 py-3 rounded-lg shadow-lg z-50';
  toastMessage.textContent = message;
  toast.classList.remove('hidden');
  
  setTimeout(() => {
    toast.classList.add('hidden');
  }, 3000);
}

function openEditModal(userId, username, role, status, avatar, diskLimit, packageName, streamLimit, expiredAt, phone) {
  document.getElementById('editUserId').value = userId;
  document.getElementById('editUsername').value = username;
  document.getElementById('editRole').value = role;
  document.getElementById('editStatus').value = status;
  document.getElementById('editPackage').value = packageName || 'custom';
  document.getElementById('editStreamLimit').value = streamLimit || 0;
  document.getElementById('editPassword').value = '';
  document.getElementById('editExpiredAt').value = expiredAt || '';
  document.getElementById('editPhone').value = phone || '';
  
  const diskLimitBytes = parseInt(diskLimit) || 0;
  const TB = 1099511627776;
  const GB = 1073741824;
  const MB = 1048576;
  
  if (diskLimitBytes >= TB) {
    document.getElementById('editDiskLimitValue').value = Math.round(diskLimitBytes / TB * 100) / 100;
    document.getElementById('editDiskLimitUnit').value = TB.toString();
  } else if (diskLimitBytes >= GB) {
    document.getElementById('editDiskLimitValue').value = Math.round(diskLimitBytes / GB * 100) / 100;
    document.getElementById('editDiskLimitUnit').value = GB.toString();
  } else {
