function autoFillLimits(prefix) {
  const packageSelect = document.getElementById(prefix + 'Package');
  const streamInput = document.getElementById(prefix + 'StreamLimit');
  const diskValue = document.getElementById(prefix + 'DiskLimitValue');
  const diskUnit = document.getElementById(prefix + 'DiskLimitUnit');
  const diskHidden = document.getElementById(prefix + 'DiskLimit');
  
  const pkg = packageSelect.value;
  const GB = 1073741824;
  
  if (pkg !== 'custom' && packagesData[pkg]) {
    const pkgData = packagesData[pkg];
    streamInput.value = pkgData.live;
    diskValue.value = pkgData.storage;
    diskUnit.value = GB.toString();
  }

  
  if (pkg !== 'custom') {
    diskHidden.value = Math.round(parseFloat(diskValue.value) * parseInt(diskUnit.value));
    // Auto-set expired 30 hari dari sekarang
    const d = new Date();
    d.setDate(d.getDate() + 30);
    const yyyy = d.getFullYear();
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const dd = String(d.getDate()).padStart(2, '0');
    const dateStr = `${yyyy}-${mm}-${dd}`;
    const editExpired = document.getElementById('editExpiredAt');
    const createExpired = document.getElementById('createExpiredAt');
    if (editExpired && prefix === 'edit') editExpired.value = dateStr;
    if (createExpired && prefix === 'create') createExpired.value = dateStr;
  }
}

