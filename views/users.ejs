<% layout('layout') -%>

<div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
  <div>
    <h2 class="text-2xl font-bold">User Management</h2>
    <p class="text-gray-400 text-sm mt-1">Manage user accounts and permissions</p>
  </div>
  <div class="flex items-center gap-2">
    <a href="/admin/users/export" 
      class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg transition-colors flex items-center shadow-lg shadow-emerald-500/20">
      <i class="ti ti-download mr-1.5"></i>
      <span>Backup / Export</span>
    </a>
    <button onclick="document.getElementById('importCsvInput').click()" 
      class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-lg transition-colors flex items-center shadow-lg shadow-blue-500/20">
      <i class="ti ti-upload mr-1.5"></i>
      <span>Import CSV</span>
    </button>
    <input type="file" id="importCsvInput" accept=".csv" class="hidden" onchange="importUsersCsv(this)">
    <button onclick="blastWhatsApp()" 
      class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg transition-colors flex items-center shadow-lg shadow-emerald-500/20"
      title="Buka panel broadcast WhatsApp untuk user yang sedang tampil di tabel">
      <i class="ti ti-brand-whatsapp mr-1.5 text-lg"></i>
      <span>Broadcast WA</span>
      <span id="btnBlastFilterCount" class="ml-1.5 px-2 py-0.5 bg-black/30 rounded-full text-xs font-bold"><%= users ? users.length : 0 %></span>
    </button>
    <button onclick="openCreateModal()" 
      class="px-4 py-2 bg-primary hover:bg-rose-600 text-white rounded-lg transition-colors flex items-center">
      <i class="ti ti-plus mr-1.5"></i>
      <span>Create New User</span>
    </button>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
  <div class="bg-gray-800 rounded-lg p-5 flex items-center justify-between">
    <div>
      <p class="text-sm text-gray-400 mb-1">Total Users</p>
      <h3 class="text-2xl font-bold text-white"><%= typeof totalUsers !== 'undefined' ? totalUsers : 0 %></h3>
    </div>
    <div class="w-12 h-12 rounded-full bg-blue-500/20 flex items-center justify-center text-blue-500">
      <i class="ti ti-users text-2xl"></i>
    </div>
  </div>
  
  <div class="bg-gray-800 rounded-lg p-5 flex items-center justify-between">
    <div>
      <p class="text-sm text-gray-400 mb-1">Total Storage Terpakai</p>
      <h3 class="text-2xl font-bold text-white"><%= typeof totalStorageUsed !== 'undefined' ? totalStorageUsed : '0 B' %></h3>
      <p class="text-xs text-gray-500 mt-1">Sisa Storage: <%= typeof totalStorageFree !== 'undefined' ? totalStorageFree : '0 B' %></p>
    </div>
    <div class="w-12 h-12 rounded-full bg-purple-500/20 flex items-center justify-center text-purple-500">
      <i class="ti ti-database text-2xl"></i>
    </div>
  </div>

  <div class="bg-gray-800 rounded-lg p-5 flex items-center justify-between">
    <div>
      <p class="text-sm text-gray-400 mb-1">Live Aktif</p>
      <h3 class="text-2xl font-bold text-white"><%= typeof totalActiveStreams !== 'undefined' ? totalActiveStreams : 0 %></h3>
    </div>
    <div class="w-12 h-12 rounded-full bg-green-500/20 flex items-center justify-center text-green-500">
      <i class="ti ti-broadcast text-2xl"></i>
    </div>
  </div>
</div>

<%
  var countExpired = 0;
  var countExpiringSoon = 0;
  var countActiveExp = 0;
  var nowFilter = new Date();
  if (users && users.length > 0) {
    users.forEach(function(u) {
      if (u.expired_at) {
        var dLeft = Math.ceil((new Date(u.expired_at) - nowFilter) / (1000*60*60*24));
        if (dLeft <= 0) countExpired++;
        else if (dLeft <= 7) countExpiringSoon++;
        else countActiveExp++;
      }
    });
  }
%>

<div class="bg-gray-800 rounded-lg p-4 mb-6 shadow-md border border-gray-700/60">
  <!-- Quick Filter Pills -->
  <div class="flex flex-wrap items-center gap-2 mb-3.5">
    <span class="text-xs font-semibold text-gray-400 mr-1 flex items-center gap-1">
      <i class="ti ti-filter"></i> Quick Filter:
    </span>
    <button type="button" onclick="setQuickExpiredFilter('all')" id="pill-all" class="px-3 py-1 rounded-full text-xs font-medium transition-all bg-primary text-white shadow-sm ring-2 ring-offset-2 ring-offset-dark-800 ring-primary">
      Semua (<%= users ? users.length : 0 %>)
    </button>
    <button type="button" onclick="setQuickExpiredFilter('expired')" id="pill-expired" class="px-3 py-1 rounded-full text-xs font-medium transition-all bg-dark-700 hover:bg-red-900/50 text-red-300 border border-red-500/30 flex items-center gap-1.5">
      <span class="w-2 h-2 rounded-full bg-red-400 animate-pulse"></span>
      🚨 Sudah Expired (<%= countExpired %>)
    </button>
    <button type="button" onclick="setQuickExpiredFilter('soon')" id="pill-soon" class="px-3 py-1 rounded-full text-xs font-medium transition-all bg-dark-700 hover:bg-yellow-900/50 text-yellow-300 border border-yellow-500/30 flex items-center gap-1.5">
      <span class="w-2 h-2 rounded-full bg-yellow-400"></span>
      ⚠️ Segera Expired (&le; 7 hr) (<%= countExpiringSoon %>)
    </button>
    <button type="button" onclick="setQuickExpiredFilter('active')" id="pill-active" class="px-3 py-1 rounded-full text-xs font-medium transition-all bg-dark-700 hover:bg-green-900/50 text-green-300 border border-green-500/30 flex items-center gap-1.5">
      <span class="w-2 h-2 rounded-full bg-green-400"></span>
      ✅ Masih Aktif (<%= countActiveExp %>)
    </button>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3">
    <!-- Search Input -->
    <div class="relative sm:col-span-2">
      <input type="text" id="searchInput" placeholder="Cari username / nomor WA..." 
        class="w-full bg-dark-700 text-white pl-9 pr-4 py-2 border border-gray-600 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary text-sm">
      <i class="ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
    </div>
    
    <!-- Filter Expired -->
    <div>
      <select id="expiredFilter" 
        class="w-full bg-dark-700 border border-gray-600 text-white px-3 py-2 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary text-sm">
        <option value="">Semua Expired</option>
        <option value="expired">🚨 Sudah Expired</option>
        <option value="soon">⚠️ Segera Expired (&le; 7 Hari)</option>
        <option value="soon3">⏰ Kritis (&le; 3 Hari)</option>
        <option value="active">✅ Masih Aktif</option>
        <option value="none">Tanpa Expired</option>
      </select>
    </div>

    <!-- Sorting -->
    <div>
      <select id="sortFilter" 
        class="w-full bg-dark-700 border border-gray-600 text-white px-3 py-2 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary text-sm font-medium text-rose-300">
        <option value="default">Urutkan: Default</option>
        <option value="expired-asc">⏱️ Expired Terdekat / Lewat Dulu</option>
        <option value="expired-desc">📅 Expired Terjauh</option>
        <option value="name-asc">🔤 Nama (A - Z)</option>
        <option value="name-desc">🔤 Nama (Z - A)</option>
        <option value="created-desc">🆕 User Terbaru</option>
      </select>
    </div>

    <!-- Role Filter -->
    <div>
      <select id="roleFilter" 
        class="w-full bg-dark-700 border border-gray-600 text-white px-3 py-2 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary text-sm">
        <option value="">All Roles</option>
        <option value="admin">Admin</option>
        <option value="member">Member</option>
      </select>
    </div>

    <!-- Status Filter -->
    <div>
      <select id="statusFilter" 
        class="w-full bg-dark-700 border border-gray-600 text-white px-3 py-2 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary text-sm">
        <option value="">All Status</option>
        <option value="active">Active</option>
        <option value="inactive">Inactive</option>
      </select>
    </div>
  </div>
</div>

<div class="bg-gray-800 rounded-lg overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead class="bg-dark-700">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">User</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Role</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Paket</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Video</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Streaming</th>
          <th onclick="toggleSortExpired()" class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider cursor-pointer hover:text-primary transition-colors select-none" title="Klik untuk sortir urutan expired">
            Expired <i class="ti ti-arrows-sort ml-1"></i>
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">No. WA</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody id="usersTableBody" class="divide-y divide-gray-700">
        <% if (users && users.length > 0) { %>
          <% users.forEach(function(user) { %>
            <%
              var rowDaysLeft = 999999;
              var rowExpState = 'none';
              var rowExpTimestamp = 0;
              if (user.expired_at) {
                var rowExpDate = new Date(user.expired_at);
                rowExpTimestamp = rowExpDate.getTime() || 0;
                rowDaysLeft = Math.ceil((rowExpDate - nowFilter) / (1000*60*60*24));
                if (rowDaysLeft <= 0) {
                  rowExpState = 'expired';
                } else if (rowDaysLeft <= 7) {
                  rowExpState = 'soon';
                } else {
                  rowExpState = 'active';
                }
              }
            %>
            <tr class="hover:bg-dark-700/50 transition-colors user-row" 
                data-username="<%= user.username.toLowerCase() %>" 
                data-display-name="<%= user.username %>"
                data-role="<%= user.user_role %>" 
                data-status="<%= user.status %>"
                data-phone="<%= user.phone || '' %>"
                data-package="<%= user.package_name || 'custom' %>"
                data-expired-state="<%= rowExpState %>"
                data-days-left="<%= rowDaysLeft %>"
                data-expired-timestamp="<%= rowExpTimestamp %>"
                data-created-timestamp="<%= new Date(user.created_at).getTime() || 0 %>">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center">
                  <div class="flex-shrink-0 h-10 w-10">
                    <div class="h-10 w-10 rounded-full overflow-hidden ring-2 ring-gray-600">
                      <% if (user.avatar_path) { %>
                        <img src="<%= user.avatar_path %>" alt="<%= user.username %>'s avatar" 
                             class="w-full h-full object-cover" 
                             onerror="this.onerror=null; this.src='/images/default-avatar.jpg';">
                      <% } else { %>
                        <img src="/images/default-avatar.jpg" alt="Default avatar" class="w-full h-full object-cover">
                      <% } %>
                    </div>
                  </div>
                  <div class="ml-4">
                    <div class="text-sm font-medium text-white"><%= user.username %></div>
                    <div class="text-sm text-gray-400">ID: <%= user.id %></div>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full 
                  <%= user.user_role === 'admin' ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800' %>">
                  <%= user.user_role %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full 
                  <%= user.status === 'active' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                  <%= user.status %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800 uppercase">
                  <%= user.package_name || 'custom' %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400 cursor-pointer hover:bg-gray-700/30 transition-colors" data-user-id="<%= user.id %>" data-username="<%= user.username %>" onclick="showVideoModal(this)">
                <div class="flex flex-col">
                  <div class="flex items-center mb-1">
                    <i class="ti ti-video mr-1"></i>
                    <span><%= user.videoCount || 0 %> video</span>
                  </div>
                  <div class="flex items-center">
                    <span class="inline-flex px-1.5 py-0.5 text-xs rounded-md bg-gray-600 text-gray-200">
                    <% if (user.totalVideoSize) { %>
                      <%= user.totalVideoSize %>
                    <% } else { %>
                      0 B
                    <% } %>
                    </span>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400 cursor-pointer hover:bg-gray-700/30 transition-colors" data-user-id="<%= user.id %>" data-username="<%= user.username %>" onclick="showStreamModal(this)">
                <div class="flex flex-col">
                  <div class="flex items-center mb-1">
                    <i class="ti ti-broadcast mr-1"></i>
                    <span><%= user.streamCount || 0 %> stream</span>
                  </div>
                  <div class="flex items-center">
                    <span class="inline-flex px-1.5 py-0.5 text-xs rounded-md bg-gray-600 text-gray-200">
                      <%= user.activeStreamCount || 0 %> online
                    </span>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <% if (user.expired_at) { %>
                  <%
                    var expDate = new Date(user.expired_at);
                    var now = new Date();
                    var daysLeft = Math.ceil((expDate - now) / (1000*60*60*24));
                  %>
                  <% if (daysLeft <= 0) { %>
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-red-900/50 text-red-300">
                      <i class="ti ti-alert-circle mr-1"></i>Expired
                    </span>
                  <% } else if (daysLeft <= 7) { %>
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-yellow-900/50 text-yellow-300">
                      <i class="ti ti-clock mr-1"></i><%= daysLeft %>h lagi
                    </span>
                  <% } else { %>
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-900/50 text-green-300">
                      <i class="ti ti-calendar mr-1"></i><%= new Date(user.expired_at).toLocaleDateString('id-ID') %>
                    </span>
                  <% } %>
                <% } else { %>
                  <span class="text-gray-600 text-xs">—</span>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <% if (user.phone) { %>
                  <a href="https://wa.me/<%= user.phone %>" target="_blank" class="inline-flex items-center gap-1 text-green-400 hover:text-green-300 transition-colors">
                    <i class="ti ti-brand-whatsapp"></i>
                    <span class="text-xs"><%= user.phone %></span>
                  </a>
                <% } else { %>
                  <span class="text-gray-600 text-xs">—</span>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                <div class="flex space-x-2">
                  <button onclick="editUser(this.dataset.id, this.dataset.username, this.dataset.role, this.dataset.status, this.dataset.avatar, this.dataset.disk, this.dataset.pkg, this.dataset.stream, this.dataset.expired, this.dataset.phone)" 
                    data-id="<%= user.id %>"
                    data-username="<%= user.username %>"
                    data-role="<%= user.user_role %>"
                    data-status="<%= user.status %>"
                    data-avatar="<%= user.avatar_path || '' %>"
                    data-disk="<%= user.disk_limit || 0 %>"
                    data-pkg="<%= user.package_name || 'custom' %>"
                    data-stream="<%= user.stream_limit || 0 %>"
                    data-expired="<%= user.expired_at || '' %>"
                    data-phone="<%= user.phone || '' %>"
                    class="text-blue-400 hover:text-blue-300 transition-colors" title="Edit User">
                    <i class="ti ti-edit"></i>
                  </button>
                  
                  <% if (user.expired_at && user.phone) { %>
                    <%
                      var expDateWA = new Date(user.expired_at);
                      var nowWA = new Date();
                      var daysLeftWA = Math.ceil((expDateWA - nowWA) / (1000*60*60*24));
                    %>
                    <% if (daysLeftWA <= 0) { %>
                      <a href="https://wa.me/<%= user.phone %>?text=<%= encodeURIComponent('Halo ' + user.username + ',\n\nAkun StreamFlow Anda telahExpired. Silakan perpanjang paket untuk melanjutkan menggunakan layanan kami.\n\nTerima kasih.') %>"
                        target="_blank"
                        class="text-green-400 hover:text-green-300 transition-colors" title="Kirim WhatsApp - Perpanjang Paket">
                        <i class="ti ti-brand-whatsapp"></i>
                      </a>
                    <% } %>
                  <% } %>
                  
                  <% if (user.id !== req.session.userId) { %>
                    <button onclick="deleteUser(this.dataset.id, this.dataset.username)" 
                      data-id="<%= user.id %>"
                      data-username="<%= user.username %>"
                      class="text-red-400 hover:text-red-300 transition-colors" title="Delete User">
                      <i class="ti ti-trash"></i>
                    </button>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr id="defaultEmptyState">
            <td colspan="8" class="px-6 py-8 text-center text-gray-400">
              <i class="ti ti-users text-4xl mb-2"></i>
              <p>No users found</p>
            </td>
          </tr>
        <% } %>
        <tr id="searchEmptyState" class="hidden">
          <td colspan="8" class="px-6 py-8 text-center text-gray-400">
            <i class="ti ti-search-off text-4xl mb-2"></i>
            <p>No users match your search criteria</p>
            <p class="text-sm mt-1">Try adjusting your filters or search terms</p>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<div id="editModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden transition-opacity">
  <div class="flex items-center justify-center min-h-screen p-4">
    <div class="bg-dark-800 rounded-lg shadow-xl w-full max-w-2xl border border-gray-600/50 transform transition-all opacity-0 scale-95 flex flex-col max-h-[90vh]" id="editModalContent">
      <div class="flex items-center justify-between p-4 border-b border-gray-600/50 flex-shrink-0">
        <div class="flex items-center">
          <h3 class="text-lg font-medium">Edit User</h3>
        </div>
        <button onclick="closeEditModal()" class="rounded-full w-8 h-8 flex items-center justify-center text-gray-400 hover:text-white hover:bg-gray-700/50 transition-colors">
          <i class="ti ti-x"></i>
        </button>
      </div>
      
      <div class="p-6 overflow-y-auto">
        <form id="editUserForm" enctype="multipart/form-data">
          <input type="hidden" id="editUserId" name="userId">
          
          <div class="mb-4 flex flex-col md:flex-row items-center md:items-start gap-4">
            <label class="block text-sm font-medium text-gray-300 w-full md:w-auto">Profile Picture</label>
            <div class="flex items-center space-x-4">
              <div class="h-16 w-16 rounded-full overflow-hidden ring-2 ring-gray-600">
                <img id="editUserAvatar" src="/images/default-avatar.jpg" alt="User avatar" class="w-full h-full object-cover">
              </div>
              <div>
                <input type="file" id="editAvatarInput" name="avatar" accept="image/*" class="hidden">
                <button type="button" onclick="document.getElementById('editAvatarInput').click()" 
                  class="px-3 py-1 bg-primary hover:bg-rose-600 text-white text-sm rounded-lg transition-colors">
                  Change Photo
                </button>
              </div>
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-4">
              <div>
                <label for="editUsername" class="block text-sm font-medium text-gray-300 mb-2">Username</label>
                <input type="text" id="editUsername" name="username" required placeholder="Enter username"
                  class="w-full bg-dark-700 border border-gray-600 text-white px-3 py-2 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary">
              </div>
              <div>
                <label for="editRole" class="block text-sm font-medium text-gray-300 mb-2">Role</label>
                <select id="editRole" name="role" 
                  class="w-full bg-dark-700 border border-gray-600 text-white px-3 py-2 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary">
                  <option value="member">Member</option>
                  <option value="admin">Admin</option>
                </select>
              </div>
              <div>
                <label for="editStatus" class="block text-sm font-medium text-gray-300 mb-2">Status</label>
                <select id="editStatus" name="status" 
                  class="w-full bg-dark-700 border border-gray-600 text-white px-3 py-2 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary">
                  <option value="active">Active</option>
                  <option value="inactive">Inactive</option>
                </select>
              </div>
              <div>
                <label for="editPassword" class="block text-sm font-medium text-gray-300 mb-2">New Password (optional)</label>
                <input type="password" id="editPassword" name="password" placeholder="Leave empty to keep current password"
                  class="w-full bg-dark-700 border border-gray-600 text-white px-3 py-2 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary">
              </div>
            </div>
            
            <div class="space-y-4">
              <div>
                <label for="editPackage" class="block text-sm font-medium text-gray-300 mb-2">Pilih Paket</label>
                <select id="editPackage" name="package_name" onchange="autoFillLimits('edit')"
                  class="w-full bg-dark-700 border border-gray-600 text-white px-3 py-2 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary">
                  <option value="custom">Custom (Atur Manual)</option>
                  <% Object.keys(pricingSettings.packages).forEach(key => { 
                    let p = pricingSettings.packages[key];
                  %>
                    <option value="<%= key %>"><%= p.name %> (<%= p.label %>)</option>
                  <% }); %>
                </select>
              </div>
              <div>
                <label for="editStreamLimit" class="block text-sm font-medium text-gray-300 mb-2">Batas Live Streaming</label>
                <input type="number" id="editStreamLimit" name="stream_limit" min="0" step="1" placeholder="0"
                  class="w-full bg-dark-700 border border-gray-600 text-white px-3 py-2 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary">
                <p class="text-xs text-gray-500 mt-1">Set ke 0 untuk unlimited.</p>
              </div>
              <div>
                <label for="editDiskLimit" class="block text-sm font-medium text-gray-300 mb-2">Disk Limit</label>
                <div class="flex gap-2">
                  <input type="number" id="editDiskLimitValue" min="0" step="1" placeholder="0"
                    class="flex-1 w-full bg-dark-700 border border-gray-600 text-white px-3 py-2 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary">
