<script>
  document.addEventListener('DOMContentLoaded', () => {
    const profileButton = document.getElementById('profile-menu-button');
    const profileDropdown = document.getElementById('profile-dropdown');
    if (!profileButton || !profileDropdown) return;
    profileButton.addEventListener('click', (e) => {
      e.stopPropagation();
      e.preventDefault();
      const isHidden = profileDropdown.classList.contains('hidden');
      profileDropdown.classList.toggle('hidden');
    });
    document.addEventListener('click', (e) => {
      const isClickInsideDropdown = profileDropdown.contains(e.target);
      const isClickOnButton = profileButton.contains(e.target);
      if (!isClickInsideDropdown && !isClickOnButton && !profileDropdown.classList.contains('hidden')) {
        profileDropdown.classList.add('hidden');
      }
    });
    profileDropdown.addEventListener('click', (e) => {
      e.stopPropagation();
    });
    const profileBtn = document.getElementById('mobile-profile-btn');
    const profilePopup = document.getElementById('mobile-profile-popup');
    if (profileBtn && profilePopup) {
      profileBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        if (profilePopup.classList.contains('hidden')) {
          profilePopup.classList.remove('hidden');
          setTimeout(() => {
            profilePopup.classList.add('show');
          }, 10);
        } else {
          profilePopup.classList.remove('show');
          setTimeout(() => {
            profilePopup.classList.add('hidden');
          }, 200);
        }
      });
      document.addEventListener('click', function (e) {
        if (!profilePopup.classList.contains('hidden') &&
          !profileBtn.contains(e.target) &&
          !profilePopup.contains(e.target)) {
          profilePopup.classList.remove('show');
          setTimeout(() => {
            profilePopup.classList.add('hidden');
          }, 200);
        }
      });
    }
    const mobileNotificationBtn = document.getElementById('mobile-notification-btn');
    const mobileNotificationPopup = document.getElementById('mobile-notification-popup');
    if (mobileNotificationBtn && mobileNotificationPopup) {
      mobileNotificationBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        hideNotificationBadge();

        const btnRect = mobileNotificationBtn.getBoundingClientRect();
        mobileNotificationPopup.style.top = '64px';
        mobileNotificationPopup.style.right = '10px';
        mobileNotificationPopup.style.left = 'auto';
        mobileNotificationPopup.style.bottom = 'auto';
        if (mobileNotificationPopup.classList.contains('hidden')) {
          mobileNotificationPopup.classList.remove('hidden');
          setTimeout(() => {
            mobileNotificationPopup.classList.add('show');
          }, 10);
        } else {
          mobileNotificationPopup.classList.remove('show');
          setTimeout(() => {
            mobileNotificationPopup.classList.add('hidden');
          }, 200);
        }
      });
      document.addEventListener('click', function (e) {
        if (!mobileNotificationPopup.classList.contains('hidden') &&
          !mobileNotificationBtn.contains(e.target) &&
          !mobileNotificationPopup.contains(e.target)) {
          mobileNotificationPopup.classList.remove('show');
          setTimeout(() => {
            mobileNotificationPopup.classList.add('hidden');
          }, 200);
        }
      });
    }

    const notificationBtn = document.getElementById('notification-btn');
    const notificationDropdown = document.getElementById('notification-dropdown');
    if (notificationBtn && notificationDropdown) {
      notificationBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        hideNotificationBadge();

        if (notificationDropdown.classList.contains('hidden')) {
          notificationDropdown.classList.remove('hidden');
        } else {
          notificationDropdown.classList.add('hidden');
        }
      });

      document.addEventListener('click', function (e) {
        if (!notificationDropdown.classList.contains('hidden') &&
          !notificationBtn.contains(e.target) &&
          !notificationDropdown.contains(e.target)) {
          notificationDropdown.classList.add('hidden');
        }
      });
    }
  });

  async function loadNotifications() {
    await loadUserNotifications();
    checkGitHubUpdates();
  }

  async function loadUserNotifications() {
    try {
      const response = await fetch('/api/notifications');
      if (!response.ok) return;
      const data = await response.json();
      if (!data.success) return;

      const notificationList = document.getElementById('notification-list');
      const mobileNotificationList = document.getElementById('mobile-notification-list');

      if (notificationList) {
        const oldUserItems = notificationList.querySelectorAll('[data-user-notification]');
        oldUserItems.forEach(el => el.remove());
      }
      if (mobileNotificationList) {
        const oldUserItems = mobileNotificationList.querySelectorAll('[data-user-notification]');
        oldUserItems.forEach(el => el.remove());
      }

      if (data.unreadCount > 0) {
        showNotificationBadge();
      }

      if (data.notifications && data.notifications.length > 0) {
        data.notifications.forEach(item => {
          let iconClass = 'ti-info-circle text-blue-400';
          let borderClass = 'border-blue-500/30';
          if (item.type === 'error') {
            iconClass = 'ti-alert-circle text-rose-500';
            borderClass = 'border-rose-500/30 bg-rose-500/5';
          } else if (item.type === 'warning') {
            iconClass = 'ti-alert-triangle text-amber-400';
            borderClass = 'border-amber-500/30 bg-amber-500/5';
          } else if (item.type === 'success') {
            iconClass = 'ti-circle-check text-emerald-400';
            borderClass = 'border-emerald-500/30 bg-emerald-500/5';
          }

          const timeStr = getTimeAgo(item.created_at);
          const html = `
            <div class="p-3 border-b border-gray-700/60 hover:bg-gray-700/40 transition-colors ${borderClass} ${item.is_read ? 'opacity-70' : ''}" data-user-notification>
              <div class="flex items-start gap-2.5">
                <i class="ti ${iconClass} text-lg flex-shrink-0 mt-0.5"></i>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between gap-1 mb-0.5">
                    <h4 class="text-xs font-semibold text-white truncate">${item.title}</h4>
                    <span class="text-[10px] text-gray-400 flex-shrink-0">${timeStr}</span>
                  </div>
                  <p class="text-xs text-gray-300 leading-snug break-words">${item.message}</p>
                </div>
              </div>
            </div>
          `;

          if (notificationList) notificationList.insertAdjacentHTML('afterbegin', html);
          if (mobileNotificationList) mobileNotificationList.insertAdjacentHTML('afterbegin', html);
        });
      }
    } catch (e) {
      console.error('Error loading user notifications:', e);
    }
  }

  function hideNotificationBadge() {
    const badge = document.querySelector('#notification-btn .bg-red-500');
    const mobileBadge = document.querySelector('#mobile-notification-btn .bg-red-500');

    if (badge) badge.classList.add('hidden');
    if (mobileBadge) mobileBadge.classList.add('hidden');

    fetch('/api/notifications/read-all', { method: 'POST' }).catch(() => {});

    const latestCommitSha = localStorage.getItem('latestCommitSha');
    if (latestCommitSha) {
      localStorage.setItem('savedCommitSha', latestCommitSha);
    }
  }

  async function checkGitHubUpdates() {
    try {
      const response = await fetch('https://api.github.com/repos/bangtutorial/PEJUANG MONET/commits?per_page=3');
      if (!response.ok) {
        return;
      }

      const commits = await response.json();

      if (commits && commits.length > 0) {
        const latestCommitSha = commits[0].sha;
        const savedCommitSha = localStorage.getItem('savedCommitSha');

        localStorage.setItem('latestCommitSha', latestCommitSha);

        showGitHubUpdateNotifications(commits);

        if (!savedCommitSha) {
          localStorage.setItem('savedCommitSha', latestCommitSha);
        } else if (savedCommitSha !== latestCommitSha) {
          showNotificationBadge();
        } else {
          const badge = document.querySelector('#notification-btn .bg-red-500');
          const mobileBadge = document.querySelector('#mobile-notification-btn .bg-red-500');
          if (badge) badge.classList.add('hidden');
          if (mobileBadge) mobileBadge.classList.add('hidden');
        }
      }
    } catch (error) {
    }
  }

  function showNotificationBadge() {
    const badge = document.querySelector('#notification-btn .bg-red-500');
    const mobileBadge = document.querySelector('#mobile-notification-btn .bg-red-500');

    if (badge) badge.classList.remove('hidden');
    if (mobileBadge) mobileBadge.classList.remove('hidden');
  }

  function showGitHubUpdateNotifications(commits) {
    const notificationList = document.getElementById('notification-list');
    const mobileNotificationList = document.getElementById('mobile-notification-list');

    if (notificationList) {
      const existingNotifications = notificationList.querySelectorAll('[data-github-notification]');
      existingNotifications.forEach(notification => notification.remove());
    }
    if (mobileNotificationList) {
      const existingNotifications = mobileNotificationList.querySelectorAll('[data-github-notification]');
      existingNotifications.forEach(notification => notification.remove());
    }

    commits.forEach(commit => {
      const timeAgo = getTimeAgo(commit.commit.author.date);
      const commitMessage = commit.commit.message.split('\n')[0];
      const shortSha = commit.sha.substring(0, 7);
      const authorName = commit.commit.author.name;

      const notificationHTML = `
        <div class="p-3 hover:bg-gray-700/50 transition-colors cursor-pointer" data-github-notification onclick="window.open('${commit.html_url}', '_blank')">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 flex-shrink-0">
              <img src="${commit.author.avatar_url}" alt="${authorName}" class="w-8 h-8 rounded-full object-cover">
            </div>
            <div class="flex-1 min-w-0">
              <h4 class="text-sm font-medium text-white mb-1">New GitHub Commit</h4>
              <p class="text-xs text-gray-300 mb-1">${commitMessage}</p>
              <p class="text-xs text-gray-400">by ${authorName} • ${timeAgo}</p>
            </div>
          </div>
        </div>
      `;

      if (notificationList) {
        notificationList.insertAdjacentHTML('beforeend', notificationHTML);
      }
      if (mobileNotificationList) {
        mobileNotificationList.insertAdjacentHTML('beforeend', notificationHTML);
      }
    });

    updateNotificationBadge();
  }

  function getTimeAgo(dateString) {
    const now = new Date();
    const date = new Date(dateString);
    const diffInSeconds = Math.floor((now - date) / 1000);

    if (diffInSeconds < 60) {
      return 'Just now';
    } else if (diffInSeconds < 3600) {
      const minutes = Math.floor(diffInSeconds / 60);
      return `${minutes} minutes ago`;
    } else if (diffInSeconds < 86400) {
      const hours = Math.floor(diffInSeconds / 3600);
      return `${hours} hours ago`;
    } else {
      const days = Math.floor(diffInSeconds / 86400);
      return `${days} days ago`;
    }
  }

  function updateNotificationBadge() {
    const badge = document.querySelector('#notification-btn .bg-red-500');
    const mobileBadge = document.querySelector('#mobile-notification-btn .bg-red-500');
    const latestCommitSha = localStorage.getItem('latestCommitSha');
    const savedCommitSha = localStorage.getItem('savedCommitSha');

    if (savedCommitSha && latestCommitSha && savedCommitSha !== latestCommitSha) {
      if (badge) badge.classList.remove('hidden');
      if (mobileBadge) mobileBadge.classList.remove('hidden');
    } else {
      if (badge) badge.classList.add('hidden');
      if (mobileBadge) mobileBadge.classList.add('hidden');
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    loadNotifications();
    initServerTime();
    // Polling notifikasi user setiap 30 detik agar update realtime jika ada rotasi gagal
    setInterval(loadUserNotifications, 30 * 1000);
    setInterval(pollBroadcastBanner, 30 * 1000);
  });

  // --- BROADCAST BANNER LOGIC ---
  function dismissBroadcastBanner() {
    const banner = document.getElementById('broadcast-banner-container');
    const mainBody = document.getElementById('main-content-body');
    if (banner) banner.classList.add('hidden');
    if (mainBody) {
      mainBody.classList.remove('!pt-28', 'lg:!pt-32');
    }
  }

  function applyBroadcastBanner(banner) {
    const container = document.getElementById('broadcast-banner-container');
    const inner = document.getElementById('broadcast-banner-inner');
    const icon = document.getElementById('broadcast-banner-icon');
    const tag = document.getElementById('broadcast-banner-tag');
    const text = document.getElementById('broadcast-banner-text');
    const mainBody = document.getElementById('main-content-body');
    const mobileBadge = document.getElementById('mobile-broadcast-badge');
    const desktopBadge = document.getElementById('desktop-broadcast-badge');

    if (!container || !inner) return;

    if (banner && banner.enabled && banner.message) {
      container.classList.remove('hidden');
      if (mainBody) mainBody.classList.add('!pt-28', 'lg:!pt-32');
      if (mobileBadge) mobileBadge.classList.remove('hidden');
      if (desktopBadge) desktopBadge.classList.remove('hidden');

      text.textContent = banner.message;
      inner.className = 'px-4 py-2.5 flex items-center justify-between gap-3 text-sm font-medium border-b text-white';

      if (banner.type === 'danger') {
        inner.classList.add('bg-rose-600', 'border-rose-700');
        icon.className = 'ti ti-alert-octagon text-base';
        tag.textContent = 'PENTING';
      } else if (banner.type === 'info') {
        inner.classList.add('bg-blue-600', 'border-blue-700');
        icon.className = 'ti ti-info-circle text-base';
        tag.textContent = 'INFORMASI';
      } else {
        inner.classList.add('bg-amber-600', 'border-amber-700');
        icon.className = 'ti ti-tool text-base';
        tag.textContent = 'MAINTENANCE';
      }
    } else {
      container.classList.add('hidden');
      if (mainBody) mainBody.classList.remove('!pt-28', 'lg:!pt-32');
      if (mobileBadge) mobileBadge.classList.add('hidden');
      if (desktopBadge) desktopBadge.classList.add('hidden');
    }
  }

  async function pollBroadcastBanner() {
    try {
      const res = await fetch('/api/broadcast-banner');
      if (!res.ok) return;
      const data = await res.json();
      if (data.success && data.banner) {
        applyBroadcastBanner(data.banner);
      }
    } catch (e) {}
  }

  async function openBroadcastModal() {
    const modal = document.getElementById('broadcastAdminModal');
    if (!modal) return;
    try {
      const res = await fetch('/api/broadcast-banner');
      const data = await res.json();
      if (data.success && data.banner) {
        const b = data.banner;
        const toggle = document.getElementById('broadcast-enabled-toggle');
        const msg = document.getElementById('broadcast-message-input');
        if (toggle) toggle.checked = !!b.enabled;
        if (msg) msg.value = b.message || '';
        const radio = document.querySelector(`input[name="broadcastType"][value="${b.type || 'warning'}"]`);
        if (radio) radio.checked = true;
      }
    } catch (e) {}
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeBroadcastModal() {
    const modal = document.getElementById('broadcastAdminModal');
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = 'auto';
    }
  }

  function setBroadcastTemplate(kind) {
    const msgInput = document.getElementById('broadcast-message-input');
    const toggle = document.getElementById('broadcast-enabled-toggle');
    if (toggle) toggle.checked = true;

    if (kind === 'maintenance') {
      const radio = document.querySelector('input[name="broadcastType"][value="warning"]');
      if (radio) radio.checked = true;
      msgInput.value = 'Pemberitahuan: Sistem sedang dalam pemeliharaan (maintenance). Beberapa fitur mungkin mengalami jeda sementara.';
    } else if (kind === 'restart') {
      const radio = document.querySelector('input[name="broadcastType"][value="warning"]');
      if (radio) radio.checked = true;
      msgInput.value = 'Perhatian: Server akan direstart sebentar lagi untuk pemeliharaan rutin. Estimasi offline 2-5 menit.';
    } else if (kind === 'normal') {
      const radio = document.querySelector('input[name="broadcastType"][value="info"]');
      if (radio) radio.checked = true;
      msgInput.value = 'Pemeliharaan server telah selesai. Seluruh sistem kini beroperasi normal kembali.';
    }
  }

  async function submitBroadcastBanner(e) {
    e.preventDefault();
    const btn = document.getElementById('btn-save-broadcast');
    const origHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="ti ti-loader animate-spin"></i> Menyimpan...';

    const enabled = document.getElementById('broadcast-enabled-toggle').checked;
    const message = document.getElementById('broadcast-message-input').value.trim();
    const typeRadio = document.querySelector('input[name="broadcastType"]:checked');
    const type = typeRadio ? typeRadio.value : 'warning';
    const sendNotif = document.getElementById('broadcast-send-notif').checked;

    try {
      const res = await fetch('/api/admin/broadcast-banner', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled, message, type, sendNotification: sendNotif })
      });
      const data = await res.json();
      if (data.success) {
        showToast('success', data.message || 'Broadcast banner berhasil diperbarui!');
        applyBroadcastBanner(data.banner);
        closeBroadcastModal();
      } else {
        showToast('error', data.error || 'Gagal menyimpan banner');
      }
    } catch (err) {
      showToast('error', 'Terjadi kesalahan saat menyimpan banner');
    } finally {
      btn.disabled = false;
      btn.innerHTML = origHtml;
    }
  }

  async function disableBroadcastBanner() {
    if (!confirm('Apakah Anda yakin ingin mematikan banner pengumuman ini?')) return;
    try {
      const res = await fetch('/api/admin/broadcast-banner', { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        showToast('info', 'Broadcast banner telah dinonaktifkan.');
        applyBroadcastBanner({ enabled: false });
        closeBroadcastModal();
      } else {
        showToast('error', data.error || 'Gagal menonaktifkan banner');
      }
    } catch (e) {
      showToast('error', 'Terjadi kesalahan');
    }
  }

  let serverTimeOffset = 0;
  let serverTimezoneOffset = 0;
  let serverTimeInterval = null;

  async function initServerTime() {
    try {
      const response = await fetch('/api/server-time');
      if (!response.ok) return;
      const data = await response.json();
      const serverTime = new Date(data.serverTime);
      const clientTime = new Date();
      serverTimeOffset = serverTime.getTime() - clientTime.getTime();
      if (typeof data.timezoneOffset === 'number') {
        serverTimezoneOffset = data.timezoneOffset;
      }
      updateServerTimeDisplay();
      if (serverTimeInterval) clearInterval(serverTimeInterval);
      serverTimeInterval = setInterval(updateServerTimeDisplay, 1000);
      setInterval(syncServerTime, 5 * 60 * 1000);
    } catch (error) {
    }
  }

  async function syncServerTime() {
    try {
      const response = await fetch('/api/server-time');
      if (!response.ok) return;
      const data = await response.json();
      const serverTime = new Date(data.serverTime);
      const clientTime = new Date();
      serverTimeOffset = serverTime.getTime() - clientTime.getTime();
      if (typeof data.timezoneOffset === 'number') {
        serverTimezoneOffset = data.timezoneOffset;
      }
    } catch (error) {
    }
  }

  function updateServerTimeDisplay() {
    const serverNowMs = Date.now() + serverTimeOffset;
    const serverWallClock = new Date(serverNowMs - serverTimezoneOffset * 60 * 1000);
    const day = String(serverWallClock.getUTCDate()).padStart(2, '0');
    const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const month = monthNames[serverWallClock.getUTCMonth()];
    const year = serverWallClock.getUTCFullYear();
    const hours = String(serverWallClock.getUTCHours()).padStart(2, '0');
    const minutes = String(serverWallClock.getUTCMinutes()).padStart(2, '0');
    const seconds = String(serverWallClock.getUTCSeconds()).padStart(2, '0');
    const dateStr = `${day} ${month} ${year}`;
    const timeStr = `${hours}:${minutes}:${seconds}`;
    const dateEl = document.getElementById('server-date');
    const clockEl = document.getElementById('server-clock');
    const mobileDateEl = document.getElementById('mobile-server-date');
    const mobileClockEl = document.getElementById('mobile-server-clock');
    if (dateEl) dateEl.textContent = dateStr;
    if (clockEl) clockEl.textContent = timeStr;
    if (mobileDateEl) mobileDateEl.textContent = dateStr;
    if (mobileClockEl) mobileClockEl.textContent = timeStr;
  }

  function openPEJUANGMONETUpdateModal() {
    const modal = document.getElementById('PEJUANGMONETUpdateModal');
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
  }

  function closePEJUANGMONETUpdateModal() {
    const modal = document.getElementById('PEJUANGMONETUpdateModal');
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = 'auto';
    }
  }

  document.addEventListener('keydown', (e) => {
    const updateModal = document.getElementById('PEJUANGMONETUpdateModal');
    if (e.key === 'Escape' && updateModal && !updateModal.classList.contains('hidden')) {
      closePEJUANGMONETUpdateModal();
    }
  });

  document.addEventListener('click', (e) => {
    const updateModal = document.getElementById('PEJUANGMONETUpdateModal');
    if (updateModal && e.target === updateModal) {
      closePEJUANGMONETUpdateModal();
    }
  });
</script>