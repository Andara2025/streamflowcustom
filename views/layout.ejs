<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %> - PEJUANG MONET
  </title>
  <link rel="icon" href="/images/logopejuang.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preload" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.30.0/fonts/tabler-icons.woff2"
    as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.30.0/tabler-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/styles.css?v=2.2">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        fontFamily: {
          'inter': ['Inter', 'sans-serif'],
          'sans': ['Inter', 'system-ui', 'sans-serif']
        },
        extend: {
          colors: {
            'primary': '#E11D48',
            'secondary': '#BE123C',
            'dark': {
              '900': '#0B0B0F',
              '800': '#161622',
              '700': '#222235',
              '600': '#33334d',
              '500': '#6E6E6E',
              '400': '#8F8F8F',
              '300': '#AFAFAF',
              '200': '#CFCFCF',
              '100': '#E5E5E5',
            },
            'gray': {
              '900': '#0B0B0F',
              '800': '#161622',
              '700': '#222235',
              '600': '#33334d',
              '500': '#6E6E6E',
              '400': '#8F8F8F',
              '300': '#AFAFAF',
              '200': '#CFCFCF',
              '100': '#E5E5E5',
              '50': '#F5F5F5',
            }
          }
        }
      }
    }
  </script>
  <script src="/js/stream-modal.js" defer></script>
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () {
        navigator.serviceWorker.register('/sw.js')
          .then(function (registration) {
            console.log('Service Worker registered successfully:', registration.scope);
          })
          .catch(function (error) {
            console.log('Service Worker registration failed:', error);
          });
      });
    }
  </script>
</head>

<body class="bg-dark-900 text-white font-inter">
  <div
    class="lg:hidden fixed top-0 left-0 right-0 h-16 bg-dark-800 shadow-lg flex items-center justify-between px-6 z-30">
    <div class="flex items-center">
      <img src="/images/logopejuang.png" alt="PEJUANG MONET Logo" class="h-8">
    </div>
    <div class="flex items-center gap-1">
      <div id="mobile-server-time" class="hidden items-center gap-1.5 text-gray-400 text-sm mr-2">
        <span id="mobile-server-date">--</span>
        <span class="text-gray-600">•</span>
        <span id="mobile-server-clock" class="tabular-nums">--:--:--</span>
      </div>
      <% if (req.session && req.session.user_role === 'admin') { %>
        <button onclick="openBroadcastModal()" class="p-2 text-gray-400 hover:text-amber-400 transition-colors relative mr-1" title="Broadcast Pesan / Banner Header">
          <i class="ti ti-speakerphone text-lg"></i>
          <span id="mobile-broadcast-badge" class="<%= (typeof broadcastBanner !== 'undefined' && broadcastBanner && broadcastBanner.enabled) ? '' : 'hidden' %> absolute top-1 right-1 w-2 h-2 bg-amber-400 rounded-full animate-ping"></span>
        </button>
      <% } %>
      <div class="relative">
        <button id="mobile-notification-btn" class="p-2 text-gray-400 hover:text-white transition-colors relative">
          <i class="ti ti-bell text-lg"></i>
          <span class="hidden absolute top-0.5 right-0.5 w-2 h-2 bg-red-500 rounded-full"></span>
        </button>
      </div>
    </div>
  </div>
  <div class="flex">
    <div class="hidden lg:flex lg:fixed lg:flex-col w-20 h-screen pt-2 bg-dark-800 shadow-lg overflow-hidden">
      <div class="flex items-center justify-center h-14 w-14 mx-auto mb-4">
        <img src="/images/logopejuang.png" alt="PEJUANG MONET Logo" class="h-9 w-auto">
      </div>
      <div class="flex-1">
        <a href="/dashboard" class="sidebar-icon group <%= active === 'dashboard' ? 'bg-primary' : '' %>">
          <i class="ti ti-broadcast text-xl"></i>
          <span class="text-xs mt-1">Streams</span>
          <span class="sidebar-tooltip group-hover:scale-100">Stream Manager</span>
        </a>
        <a href="/rotations" class="sidebar-icon group <%= active === 'rotations' ? 'bg-primary' : '' %>">
          <i class="ti ti-rotate text-xl"></i>
          <span class="text-xs mt-1">Rotations</span>
          <span class="sidebar-tooltip group-hover:scale-100">Stream Rotations</span>
        </a>
        <a href="/gallery" class="sidebar-icon group <%= active === 'gallery' ? 'bg-primary' : '' %>">
          <i class="ti ti-video text-xl"></i>
          <span class="text-xs mt-1">Gallery</span>
          <span class="sidebar-tooltip group-hover:scale-100">Video Gallery</span>
        </a>
        <a href="/playlist" class="sidebar-icon group <%= active === 'playlist' ? 'bg-primary' : '' %>">
          <i class="ti ti-playlist text-xl"></i>
          <span class="text-xs mt-1">Playlist</span>
          <span class="sidebar-tooltip group-hover:scale-100">Playlist Manager</span>
        </a>
        <a href="/history" class="sidebar-icon group <%= active === 'history' ? 'bg-primary' : '' %>">
          <i class="ti ti-history text-xl"></i>
          <span class="text-xs mt-1">History</span>
          <span class="sidebar-tooltip group-hover:scale-100">Stream History</span>
        </a>
        <% if (req.session && req.session.user_role === 'admin') { %>
          <% if (isPro) { %>
            <a href="/users" class="sidebar-icon group <%= active === 'users' ? 'bg-primary' : '' %>">
              <i class="ti ti-users text-xl"></i>
              <span class="text-xs mt-1">Users</span>
              <span class="sidebar-tooltip group-hover:scale-100">User Management</span>
            </a>
            <a href="/admin/reporting" class="sidebar-icon group <%= active === 'reporting' ? 'bg-primary' : '' %>">
              <i class="ti ti-chart-bar text-xl"></i>
              <span class="text-xs mt-1">Reports</span>
              <span class="sidebar-tooltip group-hover:scale-100">Revenue & Reports</span>
            </a>
          <% } else { %>
            <a href="/admin/activate" class="sidebar-icon group <%= active === 'activate' ? 'bg-primary' : '' %>">
              <i class="ti ti-lock-access text-xl text-yellow-500"></i>
              <span class="text-xs mt-1 text-yellow-500">Pro</span>
              <span class="sidebar-tooltip group-hover:scale-100">Unlock Pro Features</span>
            </a>
          <% } %>
        <% } %>
      </div>
      <div class="mt-auto">
        <div class="h-px bg-gray-700 w-full"></div>
        <div class="relative" id="profile-menu-container">
          <div class="h-20 flex items-center justify-center px-3 py-4 hover:bg-dark-700/50 transition-colors">
            <button id="profile-menu-button"
              class="w-12 h-12 rounded-full flex items-center justify-center overflow-hidden ring-2 ring-gray-700 hover:ring-primary transition-all">
              <%- helpers.getAvatar(req) %>
            </button>
          </div>
        </div>
      </div>
    </div>
    <div id="profile-dropdown" class="fixed bg-dark-800 shadow-xl border border-gray-700 hidden">
      <div class="px-4 py-2 border-b border-gray-700">
        <div class="font-medium">
          <%= helpers.getUsername(req) %>
        </div>
      </div>
      <a href="/settings"
        class="flex items-center px-4 py-2.5 text-sm text-gray-300 hover:bg-dark-700 hover:text-white transition-colors">
        <i class="ti ti-settings mr-3"></i>
        <span>Settings</span>
      </a>
      <div class="h-px bg-gray-700 mx-4"></div>
      <a href="/logout" class="flex items-center px-4 py-2.5 text-sm text-logout hover:bg-dark-700 transition-colors">
        <i class="ti ti-logout mr-3"></i>
        <span>Sign Out</span>
      </a>
    </div>
    <div class="w-full lg:ml-20 flex flex-col min-h-screen">
      <div
        class="hidden lg:fixed lg:flex top-0 right-0 left-20 items-center justify-end h-14 px-6 bg-dark-800 shadow-md z-10">
        <div id="server-time-display" class="flex items-center gap-1.5 text-gray-400 text-sm mr-4">
          <span id="server-date">--</span>
          <span class="text-gray-600">•</span>
          <span id="server-clock" class="tabular-nums">--:--:--</span>
        </div>
        <% if (req.session && req.session.user_role === 'admin') { %>
          <button onclick="openBroadcastModal()" class="p-2 text-gray-400 hover:text-amber-400 transition-colors relative mr-2" title="Broadcast Pesan / Banner Header">
            <i class="ti ti-speakerphone text-lg"></i>
            <span id="desktop-broadcast-badge" class="<%= (typeof broadcastBanner !== 'undefined' && broadcastBanner && broadcastBanner.enabled) ? '' : 'hidden' %> absolute top-1 right-1 w-2 h-2 bg-amber-400 rounded-full animate-ping"></span>
          </button>
        <% } %>
        <div class="relative">
          <button id="notification-btn" class="p-2 text-gray-400 hover:text-white transition-colors relative">
            <i class="ti ti-bell text-lg"></i>
            <span class="hidden absolute top-0.5 right-0.5 w-2 h-2 bg-red-500 rounded-full"></span>
          </button>
          <div id="notification-dropdown"
            class="hidden absolute right-0 mt-1 w-80 bg-dark-800 border border-gray-700 rounded-lg shadow-xl z-[60]">
            <div class="p-3 border-b border-gray-700 flex items-center justify-between">
              <h3 class="font-medium">Notifications</h3>
            </div>
            <div class="max-h-80 overflow-y-auto" id="notification-list">
            </div>
          </div>
        </div>
      </div>
      <!-- BROADCAST BANNER HEADER -->
      <div id="broadcast-banner-container" class="<%= (typeof broadcastBanner !== 'undefined' && broadcastBanner && broadcastBanner.enabled && broadcastBanner.message) ? '' : 'hidden' %> fixed top-16 lg:top-14 left-0 lg:left-20 right-0 z-30 shadow-lg transition-all duration-300">
        <div id="broadcast-banner-inner" class="px-4 py-2.5 flex items-center justify-between gap-3 text-sm font-medium border-b <%= (typeof broadcastBanner !== 'undefined' && broadcastBanner && broadcastBanner.type === 'danger') ? 'bg-rose-600 text-white border-rose-700' : ((typeof broadcastBanner !== 'undefined' && broadcastBanner && broadcastBanner.type === 'info') ? 'bg-blue-600 text-white border-blue-700' : 'bg-amber-600 text-white border-amber-700') %>">
          <div class="flex items-center gap-2.5 flex-1 min-w-0">
            <span class="w-7 h-7 rounded-full bg-black/20 flex items-center justify-center flex-shrink-0 animate-pulse">
              <i id="broadcast-banner-icon" class="ti <%= (typeof broadcastBanner !== 'undefined' && broadcastBanner && broadcastBanner.type === 'danger') ? 'ti-alert-octagon' : ((typeof broadcastBanner !== 'undefined' && broadcastBanner && broadcastBanner.type === 'info') ? 'ti-info-circle' : 'ti-tool') %> text-base"></i>
            </span>
            <div class="truncate sm:whitespace-normal flex-1">
              <span id="broadcast-banner-tag" class="font-bold mr-2 uppercase tracking-wide text-xs bg-black/30 px-2 py-0.5 rounded shadow-sm">
                <%= (typeof broadcastBanner !== 'undefined' && broadcastBanner && broadcastBanner.type === 'danger') ? 'PENTING' : ((typeof broadcastBanner !== 'undefined' && broadcastBanner && broadcastBanner.type === 'info') ? 'INFORMASI' : 'MAINTENANCE') %>
              </span>
              <span id="broadcast-banner-text"><%= (typeof broadcastBanner !== 'undefined' && broadcastBanner) ? broadcastBanner.message : '' %></span>
            </div>
          </div>
          <div class="flex items-center gap-2 flex-shrink-0">
            <% if (req.session && req.session.user_role === 'admin') { %>
              <button onclick="openBroadcastModal()" class="text-xs bg-black/25 hover:bg-black/40 px-2.5 py-1 rounded transition-colors text-white flex items-center gap-1 font-semibold" title="Edit Pesan Broadcast">
                <i class="ti ti-edit"></i> Edit
              </button>
            <% } %>
            <button onclick="dismissBroadcastBanner()" class="text-white/80 hover:text-white p-1 rounded hover:bg-black/20 transition-colors" title="Sembunyikan Banner">
              <i class="ti ti-x text-base"></i>
            </button>
          </div>
        </div>
      </div>
      <div id="main-content-body" class="p-6 pt-20 lg:pt-22 flex-1 <%= (typeof broadcastBanner !== 'undefined' && broadcastBanner && broadcastBanner.enabled && broadcastBanner.message) ? '!pt-28 lg:!pt-32' : '' %>">
        <%- body %>
      </div>
      <div class="hidden lg:flex justify-end pr-6 py-4">
        <div class="flex items-center gap-3.5">
          <a href="https://chat.whatsapp.com/FfgvEREd1ZtKJPNh8WD4If?s=cl&p=a&ilr=0&amv=0" target="_blank" rel="noopener noreferrer" 
            class="flex items-center gap-1.5 text-xs text-emerald-500 hover:text-emerald-400 font-semibold transition-colors">
            <i class="ti ti-brand-whatsapp text-sm"></i>
            <span>WhatsApp Group</span>
          </a>
          <span class="text-gray-700 text-xs">•</span>
          <div class="text-xs text-gray-500">
            PEJUANG MONET <span class="text-xs font-medium bg-gray-700 px-1 rounded">v<%= appVersion %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="lg:hidden fixed bottom-0 left-0 right-0 bg-dark-800 border-t border-gray-700 shadow-lg z-30">
    <nav class="flex justify-around items-center h-16">
      <a href="/dashboard" class="bottom-nav-item <%= active === 'dashboard' ? 'bottom-nav-active' : '' %>">
        <i class="ti ti-broadcast"></i>
        <span>Streams</span>
      </a>
      <a href="/rotations" class="bottom-nav-item <%= active === 'rotations' ? 'bottom-nav-active' : '' %>">
        <i class="ti ti-rotate"></i>
        <span>Rotations</span>
      </a>
      <a href="/gallery" class="bottom-nav-item <%= active === 'gallery' ? 'bottom-nav-active' : '' %>">
        <i class="ti ti-video"></i>
        <span>Gallery</span>
      </a>
      <a href="/playlist" class="bottom-nav-item <%= active === 'playlist' ? 'bottom-nav-active' : '' %>">
        <i class="ti ti-playlist"></i>
        <span>Playlist</span>
      </a>
      <button id="mobile-profile-btn" class="bottom-nav-item">
        <div class="relative">
          <div class="w-6 h-6 rounded-full overflow-hidden mx-auto">
            <%- helpers.getAvatar(req) %>
          </div>
        </div>
        <span>Profile</span>
      </button>
    </nav>
    <div id="mobile-profile-popup"
      class="fixed bottom-16 right-2 bg-dark-800 rounded-lg shadow-xl border border-gray-700 overflow-hidden hidden transform transition-all duration-200 ease-out opacity-0 translate-y-4 w-40 z-[9999]">
      <div class="py-2 px-3">
        <div class="text-sm font-medium mb-1">
          <%= helpers.getUsername(req) %>
        </div>
        <div class="text-xs text-gray-400 mb-2">
          <%= req.session.email || '' %>
        </div>
        <div class="h-px bg-gray-700 my-2"></div>
        <% if (req.session && req.session.user_role === 'admin') { %>
          <% if (isPro) { %>
            <a href="/users" class="flex items-center py-2 text-gray-300 hover:text-white text-sm">
              <i class="ti ti-users mr-2"></i>
              <span>Users</span>
            </a>
            <a href="/admin/reporting" class="flex items-center py-2 text-gray-300 hover:text-white text-sm">
              <i class="ti ti-chart-bar mr-2"></i>
              <span>Reports</span>
            </a>
          <% } else { %>
            <a href="/admin/activate" class="flex items-center py-2 text-yellow-500 hover:text-yellow-400 text-sm">
              <i class="ti ti-lock-access mr-2"></i>
              <span>Unlock Pro</span>
            </a>
          <% } %>
        <% } %>
            <a href="/settings" class="flex items-center py-2 text-gray-300 hover:text-white text-sm">
              <i class="ti ti-settings mr-2"></i>
              <span>Settings</span>
            </a>
            <div class="h-px bg-gray-700 my-2"></div>
            <a href="/logout" class="flex items-center py-2 text-red-400 hover:text-red-300 text-sm">
              <i class="ti ti-logout mr-2"></i>
              <span>Sign Out</span>
            </a>
      </div>
    </div>
  </div>
  <div id="mobile-notification-popup"
    class="fixed bottom-16 right-2 bg-dark-800 rounded-lg shadow-xl border border-gray-700 overflow-hidden hidden transform transition-all duration-200 ease-out opacity-0 translate-y-4 w-72 z-[60]">
    <div class="p-3 border-b border-gray-700 flex items-center justify-between">
      <h3 class="font-medium">Notifications</h3>
    </div>
    <div class="max-h-80 overflow-y-auto" id="mobile-notification-list">
    </div>
  </div>
  <div id="PEJUANGMONETUpdateModal"
    class="fixed inset-0 bg-black/60 z-[60] hidden items-center justify-center p-4 overflow-y-auto">
    <div
      class="bg-dark-800 rounded-xl shadow-xl w-full max-w-2xl m-auto flex flex-col max-h-[90vh] border border-gray-700/50">
      <div class="flex-shrink-0 flex items-center justify-between px-5 py-2 border-b border-gray-700/50">
        <h3 class="text-lg font-medium text-white flex items-center gap-2">
          <span class="text-base">🎉 Update PEJUANG MONET v2</span>
        </h3>
        <button onclick="closePEJUANGMONETUpdateModal()"
          class="text-gray-400 hover:text-white hover:bg-gray-700/50 px-2 py-1 rounded-lg transition-colors">
          <i class="ti ti-x text-lg"></i>
        </button>
      </div>
      <div class="p-5 overflow-y-auto text-gray-300 space-y-4">
        <p class="text-sm">Terima kasih buat teman-teman yang sudah menunggu. Berikut adalah update terbaru yang ada di
          PEJUANG MONET v2:</p>

        <div class="space-y-4">
          <div class="flex items-start gap-3">
            <div class="shrink-0">
              <div class="w-8 h-8 bg-blue-500/20 rounded-full flex items-center justify-center">
                <i class="ti ti-layout-dashboard text-blue-400"></i>
              </div>
            </div>
            <div>
              <h4 class="font-medium text-white text-sm">UI Baru yang Lebih Fresh</h4>
              <p class="text-gray-300 mt-1 text-sm">Tampilan baru yang lebih fresh dan user freindly. Sudah dibikin
                senyaman mungkin untuk kebutuhan live streaming.</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="shrink-0">
              <div class="w-8 h-8 bg-green-500/20 rounded-full flex items-center justify-center">
                <i class="ti ti-rocket text-green-400"></i>
              </div>
            </div>
            <div>
              <h4 class="font-medium text-white text-sm">Live Streaming Lebih Ringan</h4>
              <p class="text-gray-300 mt-1 text-sm">Di PEJUANG MONET v2, proses streaming sudah dioptimalkan, sehingga jauh
                lebih ringan dibandingkan PEJUANG MONET v1 sebelumnya.</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="shrink-0">
              <div class="w-8 h-8 bg-purple-500/20 rounded-full flex items-center justify-center">
                <i class="ti ti-calendar text-purple-400"></i>
              </div>
            </div>
            <div>
              <h4 class="font-medium text-white text-sm">Penjadwalan Live Streaming</h4>
              <p class="text-gray-300 mt-1 text-sm">Di versi baru ini, fitur penjadwalan streaming ataupun auto stop
                sudah ditambahkan dan diperbaiki dibanding versi sebelumnya.</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="shrink-0">
              <div class="w-8 h-8 bg-amber-500/20 rounded-full flex items-center justify-center">
                <i class="ti ti-bug text-amber-400"></i>
              </div>
            </div>
            <div>
              <h4 class="font-medium text-white text-sm">Fix Bug</h4>
              <p class="text-gray-300 mt-1 text-sm">Beberapa bug yang sering ditemui di versi sebelumnya sudah di fix
                pada PEJUANG MONET v2 ini, salah satunya bug streaming tiba-tiba terhenti.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% if (req.session && req.session.user_role === 'admin') { %>
  <!-- ADMIN BROADCAST BANNER MODAL -->
  <div id="broadcastAdminModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4 overflow-y-auto">
    <div class="bg-dark-800 rounded-xl shadow-2xl w-full max-w-lg border border-gray-700 overflow-hidden transform transition-all">
      <div class="p-4 border-b border-gray-700 flex items-center justify-between bg-dark-750">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-amber-500/10 flex items-center justify-center text-amber-400">
            <i class="ti ti-speakerphone text-xl"></i>
          </div>
          <div>
            <h3 class="font-semibold text-white">Broadcast Message &amp; Banner</h3>
            <p class="text-xs text-gray-400">Tampilkan pengumuman / info maintenance di header web</p>
          </div>
        </div>
        <button onclick="closeBroadcastModal()" class="text-gray-400 hover:text-white p-1 rounded-lg hover:bg-dark-700 transition-colors">
          <i class="ti ti-x text-lg"></i>
        </button>
      </div>

      <form id="broadcast-banner-form" class="p-5 space-y-4" onsubmit="submitBroadcastBanner(event)">
        <!-- TOGGLE ON/OFF -->
        <div class="flex items-center justify-between p-3.5 bg-dark-900/60 rounded-lg border border-gray-700/60">
          <div>
            <div class="font-medium text-sm text-white">Status Banner di Header</div>
            <div class="text-xs text-gray-400">Aktifkan untuk langsung menampilkan banner ke semua user</div>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="broadcast-enabled-toggle" class="sr-only peer">
            <div class="w-11 h-6 bg-dark-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-500"></div>
          </label>
        </div>

        <!-- TIPE BANNER -->
        <div>
          <label class="block text-xs font-medium text-gray-300 mb-2">Jenis Pesan / Tampilan Warna</label>
          <div class="grid grid-cols-3 gap-2">
            <label class="flex flex-col items-center justify-center p-2.5 rounded-lg border cursor-pointer transition-all bg-dark-900 border-gray-700 hover:border-amber-500 has-[:checked]:border-amber-500 has-[:checked]:bg-amber-500/10">
              <input type="radio" name="broadcastType" value="warning" class="sr-only" checked>
              <i class="ti ti-tool text-amber-400 text-lg mb-1"></i>
              <span class="text-xs font-medium text-gray-200">Maintenance</span>
              <span class="text-[10px] text-amber-400/80">Kuning Amber</span>
            </label>
            <label class="flex flex-col items-center justify-center p-2.5 rounded-lg border cursor-pointer transition-all bg-dark-900 border-gray-700 hover:border-rose-500 has-[:checked]:border-rose-500 has-[:checked]:bg-rose-500/10">
              <input type="radio" name="broadcastType" value="danger" class="sr-only">
              <i class="ti ti-alert-octagon text-rose-400 text-lg mb-1"></i>
              <span class="text-xs font-medium text-gray-200">Penting</span>
              <span class="text-[10px] text-rose-400/80">Merah Urgent</span>
            </label>
            <label class="flex flex-col items-center justify-center p-2.5 rounded-lg border cursor-pointer transition-all bg-dark-900 border-gray-700 hover:border-blue-500 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-500/10">
              <input type="radio" name="broadcastType" value="info" class="sr-only">
              <i class="ti ti-info-circle text-blue-400 text-lg mb-1"></i>
              <span class="text-xs font-medium text-gray-200">Informasi</span>
              <span class="text-[10px] text-blue-400/80">Biru Info</span>
            </label>
          </div>
        </div>

        <!-- TEMPLATE CEPAT & TEXTAREA -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="text-xs font-medium text-gray-300">Isi Pesan Manual</label>
            <span class="text-[11px] text-gray-400">Pilih template cepat:</span>
          </div>
          <div class="flex flex-wrap gap-1.5 mb-2">
            <button type="button" onclick="setBroadcastTemplate('maintenance')" class="text-[11px] px-2 py-0.5 rounded bg-dark-700 hover:bg-dark-600 text-gray-300 border border-gray-600 transition-colors">
              🛠️ Maintenance Server
            </button>
            <button type="button" onclick="setBroadcastTemplate('restart')" class="text-[11px] px-2 py-0.5 rounded bg-dark-700 hover:bg-dark-600 text-gray-300 border border-gray-600 transition-colors">
              🔄 Restart Server
            </button>
            <button type="button" onclick="setBroadcastTemplate('normal')" class="text-[11px] px-2 py-0.5 rounded bg-dark-700 hover:bg-dark-600 text-gray-300 border border-gray-600 transition-colors">
              ✅ Maintenance Selesai
            </button>
          </div>
          <textarea id="broadcast-message-input" rows="3" class="w-full bg-dark-900 border border-gray-700 rounded-lg p-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary resize-none" placeholder="Ketik pesan Anda di sini, misalnya: Server akan segera direstart untuk pemeliharaan rutin pukul 16:00 WIB..."></textarea>
        </div>

        <!-- KIRIM NOTIFIKASI JUGA -->
        <label class="flex items-start gap-2.5 p-3 rounded-lg bg-dark-900/40 border border-gray-700/50 cursor-pointer">
          <input type="checkbox" id="broadcast-send-notif" class="mt-0.5 rounded bg-dark-800 border-gray-600 text-primary focus:ring-primary">
          <span class="text-xs text-gray-300">
            <strong class="text-white block mb-0.5">Kirim juga ke Lonceng Notifikasi Semua User</strong>
            Pesan ini juga akan masuk ke riwayat notifikasi akun masing-masing user.
          </span>
        </label>

        <!-- ACTION BUTTONS -->
        <div class="flex items-center justify-between pt-2 border-t border-gray-700/60">
          <button type="button" onclick="disableBroadcastBanner()" class="px-3 py-2 text-xs text-rose-400 hover:text-rose-300 hover:bg-rose-500/10 rounded-lg transition-colors flex items-center gap-1">
            <i class="ti ti-trash"></i> Matikan Banner
          </button>
          <div class="flex items-center gap-2">
            <button type="button" onclick="closeBroadcastModal()" class="px-4 py-2 bg-dark-700 hover:bg-dark-600 text-gray-300 text-xs rounded-lg transition-colors">Batal</button>
            <button type="submit" id="btn-save-broadcast" class="px-4 py-2 bg-primary hover:bg-rose-600 text-white text-xs font-semibold rounded-lg transition-colors flex items-center gap-1.5">
              <i class="ti ti-device-floppy"></i> Simpan &amp; Terapkan
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
  <% } %>
</body>

</html>
<style>
